# Base URL of the remote content repository (manifest + Markdown bodies).
# Leave empty to use the bundled sample content in `public/content` (local dev).
#
# Examples:
#   Raw files from a content repo:
#     VITE_CONTENT_BASE_URL=https://raw.githubusercontent.com/<user>/<content-repo>/main
#   A separate GitHub Pages site:
#     VITE_CONTENT_BASE_URL=https://<user>.github.io/<content-repo>
#
# Copy this file to `.env` (or `.env.local`) and fill in the value.
VITE_CONTENT_BASE_URL=
